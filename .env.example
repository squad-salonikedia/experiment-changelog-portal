# Copy to .env.local for local development

# --- Google OAuth (keep these) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# --- Supabase (new) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# --- Legacy (only needed during migration, remove after) ---
# APPS_SCRIPT_URL=https://script.google.com/a/macros/squadstack.ai/s/.../exec
# APPS_SCRIPT_TOKEN=replace-with-the-same-secret-you-set-in-apps-script
